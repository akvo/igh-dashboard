%% C4 level 2 - containers. Reads top to bottom: source, pipeline, delivery, web tier, user.
%% Solid arrows carry data and say what flows. Dotted arrows show one thing running another.
flowchart TB
    dataverse[("<b>Microsoft Dataverse</b>")]

    subgraph airflowvm["Airflow VM - Docker Compose behind Traefik"]
        direction TB
        airflow["<b>Apache Airflow</b><br/>Orchestrates the three DAGs<br/>UI behind Traefik, :8080"]
        subgraph pipeline["Pipeline packages, installed in the Airflow image"]
            direction LR
            sync["<b>igh-data-sync</b><br/>Dataverse to bronze"]
            bronze[("<b>bronze</b><br/>dataverse_complete_raw.db")]
            b2s["<b>igh-data-transform</b><br/>bronze to silver"]
            silver[("<b>silver</b><br/>silver.db")]
            s2g["<b>igh-data-transform</b><br/>silver to gold"]
            gold[("<b>gold</b><br/>star_schema.db")]
            sync -->|"raw tables"| bronze
            bronze -->|"raw tables"| b2s
            b2s -->|"cleaned tables"| silver
            silver -->|"cleaned tables"| s2g
            s2g -->|"star schema"| gold
        end
    end

    subgraph dashvm["Dashboard VM - Docker Compose behind Traefik"]
        direction TB
        prodgold[("<b>star_schema.db</b><br/>host volume, opened read-only")]
        be["<b>Backend</b><br/>Apollo GraphQL, :4000"]
        fe["<b>Frontend</b><br/>Next.js, :3000"]
        traefik["<b>Traefik</b><br/>TLS; / to frontend,<br/>/api to backend"]
    end

    user["<b>Analyst</b><br/>Browser"]

    dataverse -->|"entity records,<br/>OAuth2 + paged reads"| pipeline
    airflow -.->|"runs the DAGs,<br/>which call"| pipeline
    pipeline ==>|"gold star_schema.db,<br/>one file over SSH"| prodgold
    prodgold -->|"rows, read-only"| be
    be -->|"GraphQL responses"| fe
    fe -->|"pages and assets"| traefik
    traefik -->|"HTTPS"| user

    classDef person fill:#fbf6eb,stroke:#8a8781,color:#3d3a36
    classDef container fill:#fff1ed,stroke:#fe7449,color:#3d3a36
    classDef store fill:#fdfbf6,stroke:#b2afa7,color:#3d3a36
    classDef ext fill:#f4f4f3,stroke:#b2afa7,color:#696763
    class user person
    class airflow,sync,b2s,s2g,be,fe,traefik container
    class bronze,silver,gold,prodgold store
    class dataverse ext
