%% Infrastructure and deployment. Reads top to bottom: GitHub, then the three machines.
%% Solid arrows carry data or requests and say what flows. Dotted arrows show one thing running another.
flowchart TB
    dv[("<b>Microsoft Dataverse</b>")]

    subgraph gh["GitHub"]
        direction TB
        repos["<b>5 repositories</b><br/>igh-dashboard, igh-data-sync,<br/>igh-data-transform, igh-airflow,<br/>igh-dashboard-content"]
        qa["<b>qa.yml</b><br/>Push and PR<br/>lint, type check, test, build"]
        dtest["<b>deploy-vm.yml</b><br/>Push to main"]
        dprod["<b>deploy-prod.yml</b><br/>Release published"]
        csync["<b>content-sync.yml</b><br/>content.yaml both ways"]
        ca["<b>akvo/composite-actions</b><br/>ssh-command action"]
        repos -.->|"on push and PR"| qa
        repos -.->|"on push to main"| dtest
        repos -.->|"on release"| dprod
        repos -.->|"on content change"| csync
        dtest -.->|"uses"| ca
        dprod -.->|"uses"| ca
    end

    subgraph airvm["Airflow VM"]
        direction TB
        a_traefik["Traefik, Let's Encrypt"]
        a_api["airflow-apiserver :8080<br/>UI + /igh/download"]
        a_sched["scheduler, dag-processor,<br/>triggerer"]
        a_redis[("redis")]
        a_worker["celery worker"]
        a_pg[("postgres")]
        a_vols[("volumes: data, logs,<br/>ssh key, letsencrypt")]
        a_flower["flower :5555<br/>compose profile"]
        a_traefik -->|"HTTPS"| a_api
        a_api -->|"DAG runs"| a_pg
        a_sched -->|"DAG and task state"| a_pg
        a_sched -->|"task messages"| a_redis
        a_redis -->|"task messages"| a_worker
        a_worker -->|"bronze, silver, gold"| a_vols
        a_redis -.->|"inspected by"| a_flower
    end

    subgraph testvm["Test VM - igh-dashboard.akvotest.org"]
        direction TB
        t_traefik["Traefik, Let's Encrypt"]
        t_fe["frontend :3000"]
        t_be["backend :4000"]
        t_db[("./data/star_schema.db<br/>re-seeded from the repo<br/>on every update")]
        t_traefik -->|"routes / to"| t_fe
        t_traefik -->|"routes /api to"| t_be
        t_be -->|"reads"| t_db
    end

    subgraph prodvm["Production VM - pipeline.impactglobalhealth.org"]
        direction TB
        p_traefik["Traefik, Let's Encrypt"]
        p_fe["frontend :3000<br/>Next.js standalone"]
        p_be["backend :4000<br/>Apollo, readonly SQLite"]
        p_db[("./data/star_schema.db<br/>IS_PRODUCTION=true<br/>never overwritten by update.sh")]
        p_traefik -->|"routes / to"| p_fe
        p_traefik -->|"routes /api to"| p_be
        p_be -->|"reads"| p_db
    end

    user["Browser"]

    ca -.->|"ssh, runs<br/>vars.COMMAND"| airvm
    ca -.->|"ssh, runs<br/>vars.COMMAND"| testvm
    ca -.->|"ssh, runs<br/>vars.COMMAND"| prodvm
    dv -->|"entity records"| airvm
    a_worker ==>|"scp star_schema.db.new<br/>then ssh mv"| p_db
    user -->|"HTTPS"| p_traefik

    classDef comp fill:#fff1ed,stroke:#fe7449,color:#3d3a36
    classDef store fill:#fdfbf6,stroke:#b2afa7,color:#3d3a36
    classDef ext fill:#f4f4f3,stroke:#b2afa7,color:#696763
    class repos,qa,dtest,dprod,csync,ca,t_traefik,t_fe,t_be,p_traefik,p_fe,p_be,a_traefik,a_api,a_sched,a_worker,a_flower comp
    class t_db,p_db,a_pg,a_redis,a_vols store
    class dv,user ext
