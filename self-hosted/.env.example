WEBDOMAIN=
NEXT_PUBLIC_GRAPHQL_ENDPOINT=/api
TRAEFIK_CERTIFICATESRESOLVERS_MYRESOLVER_ACME_EMAIL=devops@akvo.org
APP_PORT=80
APP_SSL_PORT=443
ENABLE_GRAPHQL_PLAYGROUND=false

# Set to "true" on production hosts where the gold star_schema.db is
# delivered by the Airflow pipeline (igh-airflow-data-deployment-dag).
# When true, install.sh / update.sh will NOT overwrite
# ./data/star_schema.db. Leave unset or "false" for staging, which
# seeds the DB from the bundled backend/star_schema.db on every run.
IS_PRODUCTION=false
